# Azure Cosmos DB for NoSQL (data plane only)
AZURE_COSMOSDB_ENDPOINT=https://YOUR-COSMOS-ACCOUNT.documents.azure.com:443/
AZURE_COSMOSDB_DATABASENAME=Hotels
AZURE_COSMOSDB_CONTAINER_NAME=

# Azure OpenAI embeddings
AZURE_OPENAI_EMBEDDING_ENDPOINT=https://YOUR-AOAI-RESOURCE.openai.azure.com/
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Sample behavior
VECTOR_ALGORITHM=
DATA_FILE_WITH_VECTORS=data/HotelsData_toCosmosDB_Vector.json

# Leave AZURE_COSMOSDB_CONTAINER_NAME and VECTOR_ALGORITHM empty to run both
# containers. If you set both, use hotels_diskann with diskann or
# hotels_quantizedflat with quantizedflat.
