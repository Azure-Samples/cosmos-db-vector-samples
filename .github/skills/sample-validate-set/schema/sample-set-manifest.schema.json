{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sample validation set manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "runner",
    "evidence",
    "samples",
    "validation"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "arguments",
        "allSelection"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allSelection": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "directoryPrefix",
        "runnerLog",
        "summary"
      ],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "directoryPrefix": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "runnerLog": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "summary": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        }
      }
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "selection",
          "directory",
          "outputDirectory",
          "runDirectoryPattern",
          "runFile",
          "reference"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "selection": {
            "type": "string",
            "minLength": 1
          },
          "directory": {
            "type": "string",
            "minLength": 1
          },
          "outputDirectory": {
            "type": "string",
            "minLength": 1
          },
          "runDirectoryPattern": {
            "type": "string",
            "pattern": "^[A-Za-z0-9*?._-]+$"
          },
          "runFile": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "reference": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "table"
      ],
      "properties": {
        "table": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "headerAliases",
            "keyColumns",
            "valueAliases",
            "expectedKeys",
            "exactRowCount"
          ],
          "properties": {
            "headerAliases": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "keyColumns": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "valueAliases": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "expectedKeys": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "exactRowCount": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  }
}
